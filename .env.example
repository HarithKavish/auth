# HarithKavish Auth — environment template.
# Copy to .env.local for development. Never commit real values; .env* is gitignored.

# Public origin this app is served from. Used for absolute URLs and, from Phase 4,
# as the WebAuthn relying party origin.
NEXT_PUBLIC_SITE_URL=https://auth.harithkavish.com

# The Account Platform. Every "create an account" and "manage passkeys" link
# points here — Auth never creates or manages accounts itself.
NEXT_PUBLIC_ACCOUNT_URL=https://account.harithkavish.com

# Phase 1 only. Which registered application is assumed when auth.harithkavish.com
# is opened directly with no client_id. Phase 4 rejects such requests instead of
# assuming one, and this variable goes away with it.
# NEXT_PUBLIC_DEFAULT_CLIENT_ID=forge

# ---------------------------------------------------------------------------
# Phase 4+ — not read by any code yet. Listed so deployment can be prepared.
# ---------------------------------------------------------------------------

# Where Auth verifies credentials. This is a server-to-server call into the
# Account Platform and must never be exposed to the browser (no NEXT_PUBLIC_).
# ACCOUNT_IDENTITY_API_URL=https://account.harithkavish.com/api/internal
# ACCOUNT_IDENTITY_API_KEY=

# Secret used to sign Auth's own session cookie. Generate with: openssl rand -base64 32
# SESSION_SECRET=

# Secret used to sign issued authorization codes. Separate from SESSION_SECRET so
# the two can be rotated independently.
# AUTHORIZATION_CODE_SECRET=

# WebAuthn relying party settings (Phase 4).
# WEBAUTHN_RP_ID=harithkavish.com
# WEBAUTHN_RP_NAME=HarithKavish
